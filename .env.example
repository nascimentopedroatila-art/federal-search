# =============================================================
# NEXUS - Modular Intelligence Toolkit
# .env.example
#
# Copie este arquivo para ".env" e preencha SOMENTE em
# desenvolvimento local. O arquivo ".env" NUNCA deve ser
# commitado (já está no .gitignore).
#
# Em produção/preferência, use o Windows Credential Manager:
#     python nexus.py keys set ABUSEIPDB_API_KEY
#
# ou variáveis de ambiente do sistema operacional.
# =============================================================

# Chaves de APIs (opcional - deixe vazio se não tiver)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
HUNTER_API_KEY=
EMAILREP_API_KEY=
IPQUALITYSCORE_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
WHOISXML_API_KEY=
IPINFO_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# Configuração opcional via ambiente
NEXUS_LOG_LEVEL=INFO
NEXUS_CACHE_ENABLED=true
NEXUS_DATA_DIR=
